# Wayfind — environment
#
# Nothing here is required to run the app. With no keys at all, Wayfind runs on
# free keyless services (Overpass, Wikivoyage, Wikidata, OSRM, Nominatim) and
# skips the optional LLM layer (§6b). Copy to `.env` and fill in what you have.

# --- Optional LLM layer (§6) -------------------------------------------------
# Used for exactly three jobs: interpreting the free-text interview answer,
# semantic matching of a free-text descriptor against retrieved candidates, and
# writing the per-stop rationale. The LLM never invents a place (§6b).
# Without this key all three degrade gracefully: free text is parsed by a
# deterministic keyword fallback and rationales render as null.
ANTHROPIC_API_KEY=

# Model used for the three call sites above. A small model is sufficient (§10).
LLM_MODEL=claude-haiku-4-5

# --- Flags -------------------------------------------------------------------
# Run the whole pipeline from fixtures/: no network, no keys (§11a).
FIXTURE_MODE=true

# Verbose pipeline logging: POI payloads, LLM prompts and responses (§10).
# Development only. With this off, only aggregate counters and error stages log.
DEBUG_PIPELINE=false

# Per-stop rationale generation. Cosmetic LLM spend, so off by default (§10).
ENABLE_RATIONALE=false

# --- Endpoints (override only if you self-host) ------------------------------
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Free, keyless mirrors tried in order when the primary is unhealthy. The main
# instance does go down — during testing it returned 504 for even a trivial
# query while these answered normally. Comma-separated; leave blank for the
# built-in list. Mirrors can lag the main database by weeks, so a fallback may
# have slightly stale opening hours.
OVERPASS_FALLBACK_URLS=
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Server ------------------------------------------------------------------
PORT=8787

# --- Not used by default (§5a) ----------------------------------------------
# Google Places would give the best quality signal but is the paid option; the
# flat $200/month credit was retired in March 2025 and requesting a `rating`
# field moves the call into a higher-priced SKU. A provider interface exists in
# src/server/pipeline/providers.ts so it can be swapped in behind this key.
GOOGLE_PLACES_API_KEY=
